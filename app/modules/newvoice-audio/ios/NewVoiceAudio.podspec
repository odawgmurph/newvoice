Pod::Spec.new do |s|
  s.name           = 'NewVoiceAudio'
  s.version        = '0.1.0'
  s.summary        = 'Unprocessed microphone capture feeding the NewVoice analysis core'
  s.description    = 'Opens the microphone in measurement mode, runs the Rust analysis core (newvoice-ffi) on a native thread, and sends computed frames to JavaScript. Raw audio never reaches JavaScript.'
  s.author         = 'NewVoice'
  s.license        = 'Apache-2.0'
  s.homepage       = 'https://github.com/odawgmurph/newvoice'
  s.platforms      = { :ios => '16.4' }
  s.source         = { git: '' }
  s.static_framework = true
  s.swift_version  = '5.9'

  s.dependency 'ExpoModulesCore'

  # Swift/Objective-C compatibility
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
  }

  # rust/ is generated by core/scripts/build-ios-xcframework.sh (not
  # committed): the static library, its UniFFI Swift API and the C header
  # that Swift API calls through this pod's own module.
  s.source_files = 'src/**/*.swift', 'rust/newvoice_ffi.swift', 'rust/include/*.h'
  s.vendored_frameworks = 'rust/NewVoiceFFI.xcframework'
end
